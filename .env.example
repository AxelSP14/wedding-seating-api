# Think of this file like a locker combination. The app needs these values
# to open the database. We keep them in a separate file so we never
# accidentally paste passwords into our code.
#
# HOW TO USE: copy this file, rename the copy to ".env", and fill in real values.
# The ".env" file should NEVER be committed to git.

DB_HOST=your-rds-host.rds.amazonaws.com
DB_PORT=3306
DB_NAME=wedding_invite
DB_USER=dbmasteruser
DB_PASSWORD=your-password

# Every table must end up with between MIN and MAX guests.
MIN_GUESTS_PER_TABLE=8
MAX_GUESTS_PER_TABLE=12
